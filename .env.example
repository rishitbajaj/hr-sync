# Copy this file to .env. docker compose reads .env and will not start if a value is empty.
POSTGRES_PASSWORD=
HR_SYNC_JWT_SECRET=
HR_SYNC_BOOTSTRAP_OPERATOR_USERNAME=
HR_SYNC_BOOTSTRAP_OPERATOR_PASSWORD=
HR_SYNC_BOOTSTRAP_ADMIN_USERNAME=
HR_SYNC_BOOTSTRAP_ADMIN_PASSWORD=
HR_SYNC_BOOTSTRAP_ADMIN_TENANT=
# Leave unset for the normal process. Set to demo to register /demo/** (bookings and failure injection).
# SPRING_PROFILES_ACTIVE=demo
# Compose starts Kafka and sets the publisher to kafka. Override only when this shell should use the logging publisher.
# HR_SYNC_PUBLISHER=kafka
# HR_SYNC_KAFKA_BOOTSTRAP_SERVERS=kafka:19092
# HR_SYNC_KAFKA_TOPIC=hr-sync.employee-changes
