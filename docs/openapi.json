  "components": {
    "schemas": {
      "SyncBatchRequest": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SyncEventRequest"
            }
          }
        }
      },
      "SyncEventRequest": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "example": "tenant-a"
          },
          "employeeId": {
            "type": "string",
            "example": "employee-1"
          },
          "sourceVersion": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "CREATE",
              "UPDATE",
              "DEACTIVATE"
            ],
            "example": "CREATE"
          },
          "fields": {
            "$ref": "#/components/schemas/SyncFieldsRequest"
          }
        }
      },
      "SyncFieldsRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Row One"
          },
          "email": {
            "type": "string",
            "example": "row-one@example.com"
          },
          "phone": {
            "type": "string",
            "example": "+15555550100"
          },
          "manager": {
            "type": "string",
            "example": "manager-1"
          },
          "officeCode": {
            "type": "string",
            "example": "OFFICE-1"
          },
          "pickupPoint": {
            "type": "string",
            "example": "point-1"
          },
          "specialAssistance": {
            "type": "string",
            "example": "none"
          },
          "shift": {
            "type": "string",
            "example": "DAY"
          }
        }
      },
      "SyncBatchResponse": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SyncRecordResponse"
            }
          },
          "correlationId": {
            "type": "string"
          }
        }
      },
      "SyncRecordResponse": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "example": "tenant-a"
          },
          "employeeId": {
            "type": "string",
            "example": "employee-1"
          },
          "sourceVersion": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "outcome": {
            "type": "string",
            "description": "APPLIED stores the change. REJECTED is a validation or constraint failure. IGNORED is DUPLICATE or STALE_IGNORED. RETRYABLE_ERROR is DATABASE_UNAVAILABLE or NOT_PROCESSED and the HTTP status is 503.",
            "enum": [
              "APPLIED",
              "REJECTED",
              "IGNORED",
              "RETRYABLE_ERROR"
            ]
          },
          "reasonCode": {
            "type": "string",
            "description": "Omitted when outcome is APPLIED.",
            "enum": [
              "MISSING_REQUIRED_FIELD",
              "INVALID_PHONE",
              "INVALID_EMAIL",
              "INVALID_SHIFT",
              "UNKNOWN_OFFICE",
              "DUPLICATE",
              "STALE_IGNORED",
