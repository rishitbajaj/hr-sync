{
  "openapi": "3.1.0",
  "info": {
    "title": "hr-sync",
    "description": "Roster sync. A bearer token is the `token` from POST /auth/token.\nIngest outcomes are APPLIED, REJECTED, IGNORED, and RETRYABLE_ERROR.\nRETRYABLE_ERROR is HTTP 503. The body is the per-record results plus correlationId, and Retry-After is set.\nGET /health, POST /auth/token, and /demo/** are open. Everything else needs the role named on the operation.\nGET /actuator/prometheus, GET /actuator/health, and GET /actuator/metrics are operator routes. Their bodies are the actuator formats, not this document's schemas.\n",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:37789",
      "description": "Generated server url"
    }
  ],
  "paths": {
    "/sync/transport-events": {
      "post": {
        "tags": [
          "sync-event-controller"
        ],
        "summary": "Apply a transport batch",
        "description": "Admin. Type must be UPDATE. Transport fields are pickupPoint and specialAssistance. HR fields in the body are ignored. Outcomes match POST /sync/events, including RETRYABLE_ERROR and the 503 body.",
        "operationId": "transport",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncBatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "No record is RETRYABLE_ERROR.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/SyncBatchResponse"
                }
              }
            }
          },
          "503": {
            "description": "At least one record is RETRYABLE_ERROR / DATABASE_UNAVAILABLE or NOT_PROCESSED.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/SyncBatchResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Not an admin, or the body tenant does not match the token.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/sync/events": {
      "post": {
        "tags": [
          "sync-event-controller"
        ],
        "summary": "Apply an HR batch",
        "description": "Admin. Outcomes are APPLIED, REJECTED, IGNORED, and RETRYABLE_ERROR. A RETRYABLE_ERROR record makes the status 503. The 503 body is results plus correlationId. Retry-After is set. DATABASE_UNAVAILABLE was not stored. NOT_PROCESSED was not attempted. Records already APPLIED in that body stay applied. reasonCode is omitted on APPLIED.",
        "operationId": "sync",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncBatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "No record is RETRYABLE_ERROR.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/SyncBatchResponse"
                }
              }
            }
          },
          "503": {
            "description": "At least one record is RETRYABLE_ERROR.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/SyncBatchResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Not an admin, or the body tenant does not match the token.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/reconciliation/runs": {
      "post": {
        "tags": [
          "reconciliation-controller"
        ],
        "summary": "Start a reconciliation",
        "description": "Admin. Body is text/csv. A repeated employee id or a row for another tenant is 400 and writes nothing. A second RUNNING run for the tenant is 409 CONFLICT. A missing-ratio halt is 200 with status HALTED.",
        "operationId": "start",
        "parameters": [
          {
            "name": "tenantId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The run was stored. Status is one of RUNNING, COMPLETED, HALTED, or FAILED.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ReconciliationRunResponse"
                }
              }
            }
          },
          "400": {
            "description": "The file was rejected.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Not an admin.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "A run is already RUNNING for this tenant.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/reconciliation/runs/{id}/approve": {
      "post": {
        "tags": [
          "reconciliation-controller"
        ],
        "summary": "Approve a halted reconciliation",
        "description": "Operator. Applies the halted deactivation set. A superseded halt is 409 SUPERSEDED and deactivates nobody.",
        "operationId": "approve",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "tenantId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The halt was approved.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ReconciliationRunResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Not an operator.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "No such run.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "SUPERSEDED or the run is not HALTED.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/outbox/{id}/replay": {
      "post": {
        "tags": [
          "outbox-operator-controller"
        ],
        "summary": "Replay a failed outbox row",
        "description": "Operator. The row goes back to PENDING with attempts 0. Only a FAILED row can be replayed.",
        "operationId": "replay",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "tenantId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The row is pending again."
          },
          "401": {
            "description": "Missing or invalid token.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Not an operator.",
